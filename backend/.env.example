# AuditXP: Риск-менеджмент. Пример файла настроек backend/.env
# Скопируйте файл в backend/.env и замените значения

APP_ENV=production
# Строка подключения к PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://auditxp:CHANGE_ME@localhost:5432/auditxp
# Создавать таблицы при запуске и заполнять демо-данными
AUTO_CREATE_SCHEMA=true
SEED_DEMO=false

# Секреты не короче 32 символов (openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
SIGNATURE_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_EXPIRES_MINUTES=480
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5

# Подключение к ERP. Режим mock включает демонстрационный источник
ERP_MODE=http
ERP_BASE_URL=https://erp.goldberg.local/api/v1
ERP_TOKEN=CHANGE_ME
ERP_RETRY_ATTEMPTS=3
ERP_RETRY_DELAY=1.0
ERP_PAGE_SIZE=5000

# Бизнес-правила
RISK_THRESHOLD=0.85
FRAUD_ALERT_AMOUNT=10000
ESCALATION_DAYS=30
ESCALATION_SCORE=15
RETENTION_YEARS=5

# Почтовый сервер для уведомлений. Пустой SMTP_HOST включает файл outbox
SMTP_HOST=smtp.goldberg-soft.by
SMTP_PORT=587
SMTP_USER=auditxp
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM=auditxp@goldberg-soft.by

# Адреса клиентской части для CORS (через запятую)
CORS_ORIGINS=https://auditxp.goldberg-soft.by
# Каталог собранной клиентской части
FRONTEND_DIST=/opt/auditxp/frontend/dist
